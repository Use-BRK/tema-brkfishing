{%- liquid
  assign theme_st = settings
  assign show_add_cart = theme_st.show_add_cart
  assign hidden_price = theme_st.hidden_price
  assign show_message_when_remove = theme_st.show_message_when_remove
  assign show_currency_code = theme_st.show_currency_code
  assign show_quantity = theme_st.show_quantity_input

  assign is_perso = false
  if item.sku == 'PE1198'
    assign is_perso = true
  endif
  assign perso_arte = ''
  if is_perso
    for property in item.properties
      if property.first == 'Arte'
        assign perso_arte = property.last
      endif
    endfor
  endif

  comment
    BRK Bundles (lê o metafield `live` do app):
    - Isenção com "Mostrar desconto do add-on no carrinho" (só visual): o desconto
      real fica no(s) produto(s) do bundle, numa alocação com o label do add-on como
      título. Aqui ele some desses produtos e aparece nas linhas do add-on: o total
      de cada label é repartido entre elas na ordem do carrinho. Desconto misto (com
      brinde que não tem "Mostrar desconto") fica com a exibição normal.
    - brk_max: quantas unidades a linha do add-on ainda aceita com desconto (o JS do
      carrinho manda o excedente para uma linha sem o bundle). Com "Limite por
      produto do bundle", o máximo vale por unidade dos produtos que puxaram o add-on.
  endcomment
  assign brk_final = item.final_price
  assign brk_final_line = item.final_line_price
  assign brk_hide_titles = '|'
  assign brk_addon_title = ''
  assign brk_addon_amount = 0
  assign brk_limited = false
  assign brk_max = 0
  assign brk_live = shop.metafields.brk_bundles.live.value
  comment
    Vitrine v2 (brk_bundles.live_index com `on`): o bundle da linha vem direto do
    registro dele (campo `storefront`, mesmo formato do `live`), sem varrer o `live`.
  endcomment
  assign brk_ix = shop.metafields.brk_bundles.live_index.value
  assign brk_v2 = false
  if brk_ix and brk_ix.on and brk_ix.mo != blank
    assign brk_v2 = true
  endif
  if brk_live or brk_v2
    assign brk_own_bundle = item.properties['_brk_bundle']
    assign brk_own_item = item.properties['_brk_bundle_item'] | append: ''
    assign brk_own_label = ''
    assign brk_per = 0
    assign brk_per_trigger = false
    if brk_own_bundle != blank
      assign brk_b = nil
      if brk_v2
        assign brk_h = brk_own_bundle | downcase | replace: '_', '-'
        assign brk_b = shop.metaobjects[brk_ix.mo][brk_h].storefront.value
      else
        for brk_x in brk_live
          if brk_x.id == brk_own_bundle
            assign brk_b = brk_x
            break
          endif
        endfor
      endif
      if brk_b
        for brk_a in brk_b.addons
          assign brk_a_pid = brk_a.productId | append: ''
          if brk_a_pid != brk_own_item
            continue
          endif
          assign brk_per = 1
          if brk_a.maxQty != nil and brk_a.maxQty != ''
            assign brk_per = brk_a.maxQty | plus: 0
          endif
          if brk_b.limitPerTrigger
            assign brk_per_trigger = true
          endif
          if brk_b.exemption and brk_b.showAddonDiscount
            assign brk_own_label = brk_a.label | default: brk_a.title | default: 'Bundle'
            if brk_a.mode == 'percent'
              assign brk_own_label = brk_own_label | replace: '{{brk_discount_percentage}}', brk_a.value
            elsif brk_a.mode == 'fixed'
              assign brk_own_label = brk_own_label | replace: '{{brk_discount_flat}}', brk_a.value
            endif
          endif
        endfor
      endif
    endif

    comment
      Uma passada no carrinho: labels exibidos no add-on (brk_labels), gatilhos do
      mesmo bundle (brk_triggers), unidades do mesmo add-on em outras linhas e o
      quanto as linhas anteriores com o mesmo label já consomem do total (brk_before).
    endcomment
    assign brk_labels = '|'
    assign brk_triggers = '|'
    assign brk_other_units = 0
    assign brk_before = 0
    assign brk_seen_self = false
    for brk_line in cart.items
      if brk_line.key == item.key
        assign brk_seen_self = true
      endif
      assign brk_line_bundle = brk_line.properties['_brk_bundle']
      if brk_line_bundle == blank
        continue
      endif
      assign brk_line_item = brk_line.properties['_brk_bundle_item'] | append: ''
      if brk_line_bundle == brk_own_bundle
        assign brk_line_trigger = brk_line.properties['_brk_bundle_trigger'] | append: ''
        assign brk_triggers = brk_triggers | append: brk_line_trigger | append: '|'
        if brk_line_item == brk_own_item and brk_line.key != item.key
          assign brk_other_units = brk_other_units | plus: brk_line.quantity
        endif
      endif
      assign brk_b = nil
      if brk_v2
        assign brk_h = brk_line_bundle | downcase | replace: '_', '-'
        assign brk_b = shop.metaobjects[brk_ix.mo][brk_h].storefront.value
      else
        for brk_x in brk_live
          if brk_x.id == brk_line_bundle
            assign brk_b = brk_x
            break
          endif
        endfor
      endif
      if brk_b and brk_b.exemption and brk_b.showAddonDiscount
        for brk_a in brk_b.addons
          assign brk_a_pid = brk_a.productId | append: ''
          if brk_a_pid != brk_line_item
            continue
          endif
          assign brk_lbl = brk_a.label | default: brk_a.title | default: 'Bundle'
          if brk_a.mode == 'percent'
            assign brk_lbl = brk_lbl | replace: '{{brk_discount_percentage}}', brk_a.value
          elsif brk_a.mode == 'fixed'
            assign brk_lbl = brk_lbl | replace: '{{brk_discount_flat}}', brk_a.value
          endif
          assign brk_labels = brk_labels | append: brk_lbl | append: '|'
          if brk_seen_self == false and brk_lbl == brk_own_label
            assign brk_before = brk_before | plus: brk_line.final_line_price
          endif
        endfor
      endif
    endfor

    if brk_per > 0
      assign brk_limited = true
      assign brk_allowed = brk_per
      if brk_per_trigger
        assign brk_units = 0
        for brk_line in cart.items
          if brk_line.properties['_brk_bundle'] != blank
            continue
          endif
          assign brk_needle = '|' | append: brk_line.product_id | append: '|'
          if brk_triggers contains brk_needle
            assign brk_units = brk_units | plus: brk_line.quantity
          endif
        endfor
        assign brk_allowed = brk_per | times: brk_units
      endif
      assign brk_max = brk_allowed | minus: brk_other_units | at_least: 0
    endif

    if brk_own_bundle != blank
      if brk_own_label != ''
        assign brk_total = 0
        for brk_line in cart.items
          if brk_line.properties['_brk_bundle'] != blank
            continue
          endif
          for brk_alloc in brk_line.line_level_discount_allocations
            assign brk_parts = brk_alloc.discount_application.title | split: ' + '
            unless brk_parts contains brk_own_label
              continue
            endunless
            assign brk_all_shown = true
            for brk_part in brk_parts
              assign brk_needle = '|' | append: brk_part | append: '|'
              unless brk_labels contains brk_needle
                assign brk_all_shown = false
              endunless
            endfor
            if brk_all_shown
              assign brk_total = brk_total | plus: brk_alloc.amount
            endif
          endfor
        endfor
        assign brk_addon_amount = brk_total | minus: brk_before | at_least: 0 | at_most: item.final_line_price
        if brk_addon_amount > 0
          assign brk_addon_title = brk_own_label
          assign brk_final_line = item.final_line_price | minus: brk_addon_amount
          assign brk_final = brk_final_line | divided_by: item.quantity
        endif
      endif
    elsif brk_labels != '|'
      assign brk_restore = 0
      for brk_alloc in item.line_level_discount_allocations
        assign brk_parts = brk_alloc.discount_application.title | split: ' + '
        assign brk_all_shown = true
        for brk_part in brk_parts
          assign brk_needle = '|' | append: brk_part | append: '|'
          unless brk_labels contains brk_needle
            assign brk_all_shown = false
          endunless
        endfor
        if brk_all_shown
          assign brk_restore = brk_restore | plus: brk_alloc.amount
          assign brk_hide_titles = brk_hide_titles | append: brk_alloc.discount_application.title | append: '|'
        endif
      endfor
      if brk_restore > 0
        assign brk_final_line = item.final_line_price | plus: brk_restore
        assign brk_final = brk_final_line | divided_by: item.quantity
      endif
    endif
  endif
-%}
{%- liquid
  comment
    Linha do minicart: total da linha (preço × quantidade) com o detalhe "2 × R$ X"
    quando há mais de uma unidade; o seletor de quantidade aparece sempre (fora do
    modo catálogo), independente da opção de card de produto.
  endcomment
  assign brk_compare_line = 0
  if item.original_line_price != brk_final_line
    assign brk_compare_line = item.original_line_price
  elsif item.variant.compare_at_price > item.variant.price
    assign brk_compare_line = item.variant.compare_at_price | times: item.quantity
  endif
-%}
<div
  id="minicart__product-{{ item.key }}"
  product-handle="{{ item.product.handle }}"
  {% if brk_limited %}data-brk-max="{{ brk_max }}" data-brk-variant="{{ item.variant_id }}"{% endif %}
  class="cart-item brk-line"
>
  <a href="{{- item.url -}}" class="brk-line__media" aria-label="{{ item.product.title | escape }}" tabindex="-1">
    {%- if is_perso and perso_arte != blank -%}
      <img src="{{ perso_arte }}" alt="Personalização" width="64" height="80" loading="lazy">
    {%- elsif item.image != blank -%}
      {%- assign image_alt = item.image.alt | default: item.product.title | escape -%}
      {% render 'responsive-image',
        type: 'product',
        image: item.image,
        image_alt: image_alt,
        custom_widths: '240, 180, 120',
        no_animate: true
      %}
    {%- else -%}
      {% render 'placeholder-render' %}
    {%- endif -%}
  </a>
  <div class="brk-line__body minicart__product-info">
    <div class="brk-line__top">
      <div class="brk-line__info">
        <a class="brk-line__title" href="{{- item.url -}}">{{- item.product.title | escape -}}</a>
        <div class="brk-line__meta">
          {%- unless item.product.has_only_default_variant -%}
            {%- for option in item.options_with_values -%}
              <span>{{ option.name }}: {{ option.value }}</span>
            {%- endfor -%}
          {%- endunless -%}
          {%- for property in item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- if property.last == blank or property_first_char == '_' -%}{%- continue -%}{%- endif -%}
            {%- comment -%} no item de personalização: esconde SKU interno e o link do arquivo (a arte já é a miniatura) {%- endcomment -%}
            {%- if is_perso and property.first == 'Produto' -%}{%- continue -%}{%- endif -%}
            {%- if is_perso and property.first == 'Arte' -%}{%- continue -%}{%- endif -%}
            <span>
              {{ property.first }}:
              {% if property.last contains '/uploads/' -%}
                <a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>
              {%- else -%}
                {{ property.last }}
              {%- endif %}
            </span>
          {%- endfor -%}
        </div>
      </div>
      {% if theme_st.enable_catalog_mode == false %}
        <mini-cart-remove-button
          data-product-handle="{{ item.product.id }}"
          class="minicart__item-remove brk-line__remove{% if show_message_when_remove %} action-add-wishlist{% endif %}"
          data-index="{{- item.key -}}"
        >
          <a
            href="{{ item.url_to_remove }}"
            class="cart-remove"
            aria-label="{{- 'general.cart.remove' | t -}}"
            title="{{- 'general.cart.remove' | t -}}"
          >
            <svg class="remove-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V6"/><path d="M10 11v6M14 11v6"/>
            </svg>
            <div class="icon-rotator"></div>
          </a>
        </mini-cart-remove-button>
      {% endif %}
    </div>
    <ul
      class="discounts brk-line__discounts list-unstyled"
      role="list"
      aria-label="{{ 'customer.order.discount' | t }}"
    >
      {%- if brk_addon_amount > 0 -%}
        <li class="discounts__discount">{{ brk_addon_title }} (-{{ brk_addon_amount | money }})</li>
      {%- endif -%}
      {%- for discount in item.line_level_discount_allocations -%}
        {%- assign brk_needle = '|' | append: discount.discount_application.title | append: '|' -%}
        {%- if brk_hide_titles contains brk_needle -%}{%- continue -%}{%- endif -%}
        <li class="discounts__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</li>
      {%- endfor -%}
    </ul>
    <div class="brk-line__bottom">
      {% if theme_st.enable_catalog_mode == false %}
        <div class="brk-line__qty">
          <quantity-input class="quantity brk-qty">
            <button class="quantity__button no-js-hidden" name="minus" type="button" data-id="{{- item.key -}}" aria-label="Diminuir quantidade">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <label class="visually-hidden" for="{{- item.key -}}">{{ 'general.cart.headings.quantity' | t }}</label>
            <input
              class="quantity-input"
              type="number"
              id="{{- item.key -}}"
              name="updates[]"
              data-id="{{- item.key -}}"
              value="{{- item.quantity -}}"
              data-value="{{- item.quantity -}}"
              min="0"
              inputmode="numeric"
            >
            <button class="quantity__button no-js-hidden" name="plus" type="button" data-id="{{- item.key -}}" aria-label="Aumentar quantidade">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 5h8M5 1v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </quantity-input>
          {%- unless item.product.has_only_default_variant -%}
            {% if show_add_cart %}
              <minicart-item-edit
                data-text-header="{{ 'general.cart.cart_edit' | t }}"
                data-custom-class="cart-item-edit"
                href="{{ item.url }}"
                class="minicart__item-edit brk-line__edit pointer"
                data-id="{{ item.id }}"
                data-key="{{ item.key }}"
                data-quantity="{{ item.quantity }}"
                title="{{ 'general.cart.cart_edit' | t }}"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                </svg>
              </minicart-item-edit>
            {% endif %}
          {%- endunless -%}
        </div>
      {% endif %}
      {% if hidden_price == false %}
        <div class="brk-line__price">
          {%- if brk_compare_line > brk_final_line -%}
            <s class="brk-line__compare">{% if show_currency_code %}{{ brk_compare_line | money_with_currency }}{% else %}{{ brk_compare_line | money }}{% endif %}</s>
          {%- endif -%}
          <span class="brk-line__total{% if brk_compare_line > brk_final_line %} is-sale{% endif %}">
            {%- if show_currency_code %}{{ brk_final_line | money_with_currency }}{% else %}{{ brk_final_line | money }}{% endif -%}
          </span>
          {%- if item.quantity > 1 -%}
            <span class="brk-line__unit">{{ item.quantity }} × {% if show_currency_code %}{{ brk_final | money_with_currency }}{% else %}{{ brk_final | money }}{% endif %}</span>
          {%- endif -%}
          {%- if item.variant.available and item.unit_price_measurement -%}
            <span class="brk-line__unit">
              {% if show_currency_code %}{{ item.variant.unit_price | money_with_currency }}{% else %}{{ item.variant.unit_price | money }}{% endif %}/
              {%- if item.variant.unit_price_measurement.reference_value != 1 -%}{{- item.variant.unit_price_measurement.reference_value -}}{%- endif -%}
              {{ item.variant.unit_price_measurement.reference_unit }}
            </span>
          {%- endif -%}
        </div>
      {% endif %}
    </div>
    <div
      class="cart-item__error brk-line__error"
      id="CartDrawer-LineItemError-{{ item.key }}"
      role="alert"
    >
      <span class="cart-item__error-text cart-item__error-text-{{ item.id }}"></span>
    </div>
  </div>
  {% if show_message_when_remove %}
    <div class="flex-1 relative minicart__wishlist fadeIn" style="display: none;">
      <p class="pr-20">
        {{ 'templates.wishlist.title_remove' | t }}
      </p>
      <minicart-wishlist-action
        data-index="{{- item.key -}}"
        class="mt-10 flex gap-10 relative align-center"
        style="--btn-padding-y: 8px;--btn-padding-x: 2.5rem;"
      >
        <a
          data-product-id="{{ item.product.id }}"
          data-index="{{- item.key -}}"
          class="btn-primary btn-small product-wishlist-js btn-minicart__add-wishlist-js pointer fs-small"
          type="button"
          role="button"
          aria-label="{{ 'templates.wishlist.action_yes' | t }}"
        >
          {{ 'templates.wishlist.action_yes' | t }}
        </a>
        <a
          data-index="{{- item.key -}}"
          class="btn-outline btn-small bg-grey btn-minicart__remove-js pointer text-center fs-small"
          type="button"
          role="button"
          aria-label="{{ 'templates.wishlist.action_no' | t }}"
        >
          {{ 'templates.wishlist.action_no' | t }}
        </a>
        <div class="icon-rotator"></div>
      </minicart-wishlist-action>
      <a href="#" class="cart-close-wishlist button--tertiary absolute top-0 right-0 z-1 grey-color pointer">
        <svg width="14" height="14" fill="none">
          <use href="#icon-trash" />
        </svg>
      </a>
    </div>
  {% endif %}
</div>

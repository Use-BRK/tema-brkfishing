{%- comment -%}
  Prova social: carrossel de vídeos em autoplay (mudos, em loop).
  Cada bloco é um grupo: SKUs iniciais + liga/desliga + até 6 vídeos.
  Aparece o primeiro grupo ligado em que algum SKU de variante começa com um dos prefixos.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign group = nil

  for b in section.blocks
    if b.settings.enabled != true or b.settings.sku_prefixes == blank
      continue
    endif
    assign sku_prefixes = b.settings.sku_prefixes | upcase | split: ','
    for v in product.variants
      assign v_sku = v.sku | upcase | strip
      if v_sku == blank
        continue
      endif
      for raw in sku_prefixes
        assign pfx = raw | strip
        if pfx == blank
          continue
        endif
        assign v_start = v_sku | slice: 0, pfx.size
        if v_start == pfx
          assign group = b
          break
        endif
      endfor
      if group
        break
      endif
    endfor
    if group
      break
    endif
  endfor

  assign video_count = 0
  if group
    for i in (1..6)
      assign vid_key = 'video_' | append: i
      if group.settings[vid_key] != blank
        assign video_count = video_count | plus: 1
      endif
    endfor
  endif
-%}

{%- if video_count > 0 -%}
  <div
    class="brk-social section"
    id="BrkSocial-{{ section.id }}"
    style="--section-pt: {{ st.padding_top }}; --section-pb: {{ st.padding_bottom }};"
  >
    {%- if st.eyebrow != blank or st.title != blank -%}
      <h2 class="brk-social__heading">
        {%- if st.eyebrow != blank -%}<span class="brk-social__eyebrow">{{ st.eyebrow }}</span>{%- endif -%}
        {%- if st.title != blank -%}<span class="brk-social__title">{{ st.title }}</span>{%- endif -%}
      </h2>
    {%- endif -%}
    <div class="brk-social__track" {{ group.shopify_attributes }}>
      {%- for i in (1..6) -%}
        {%- liquid
          assign vid_key = 'video_' | append: i
          assign vid = group.settings[vid_key]
          if vid == blank
            continue
          endif

          comment
            Fonte mp4 mais leve com pelo menos 480px de largura (cards têm ~300px)
          endcomment
          assign vid_src = nil
          for s in vid.sources
            if s.format != 'mp4'
              continue
            endif
            if vid_src == nil
              assign vid_src = s
            elsif s.width >= 480 and vid_src.width < 480
              assign vid_src = s
            elsif s.width >= 480 and s.width < vid_src.width
              assign vid_src = s
            elsif vid_src.width < 480 and s.width > vid_src.width
              assign vid_src = s
            endif
          endfor

          comment
            @ do influencer: campo do grupo; se vazio, usa o texto alternativo do vídeo quando começa com @
          endcomment
          assign inf_key = 'influencer_' | append: i
          assign inf = group.settings[inf_key] | strip | remove: '@'
          if inf == blank
            assign vid_alt = vid.alt | strip
            assign alt_first = vid_alt | slice: 0
            if alt_first == '@'
              assign inf = vid_alt | split: ' ' | first | remove: '@'
            endif
          endif

          comment
            Produto do card: o escolhido no grupo ou, se vazio, o próprio produto da página
          endcomment
          assign prod_key = 'product_' | append: i
          assign card_product = group.settings[prod_key] | default: product
        -%}
        {%- if vid_src -%}
          <div class="brk-social__card">
            {%- if inf != blank -%}
              <span class="brk-social__influencer">
                @{{ inf }}
                <svg class="brk-social__verified" viewBox="0 0 24 24" aria-label="Verificado" role="img">
                  <path fill="#1d9bf0" d="M22.5 12.5c0-1.58-.88-2.95-2.18-3.65.15-.44.23-.91.23-1.4 0-2.21-1.71-3.99-3.82-3.99-.47 0-.92.08-1.34.25C14.79 2.38 13.49 1.5 12 1.5s-2.79.88-3.39 2.21c-.42-.17-.87-.25-1.34-.25-2.11 0-3.82 1.78-3.82 3.99 0 .49.08.96.23 1.4-1.3.7-2.18 2.07-2.18 3.65 0 1.5.79 2.8 1.97 3.53-.03.24-.05.48-.05.72 0 2.21 1.71 3.99 3.82 3.99.47 0 .92-.09 1.34-.25.6 1.33 1.9 2.21 3.39 2.21s2.79-.88 3.39-2.21c.42.16.87.25 1.34.25 2.11 0 3.82-1.78 3.82-3.99 0-.24-.02-.48-.05-.72 1.17-.73 1.97-2.03 1.97-3.53z"/>
                  <path fill="#fff" d="M10.54 16.2 6.8 12.46l1.41-1.41 2.26 2.26 4.8-5.23 1.47 1.35z"/>
                </svg>
              </span>
            {%- endif -%}
            <video
              class="brk-social__video"
              muted
              loop
              playsinline
              preload="none"
              {% if vid.preview_image %}data-poster="{{ vid.preview_image | image_url: width: 600 }}"{% endif %}
              aria-label="{{ vid.alt | default: st.title | escape }}"
            >
              <source src="{{ vid_src.url }}" type="{{ vid_src.mime_type }}">
            </video>
            {%- if card_product -%}
              <a class="brk-social__product" href="{{ card_product.url }}" draggable="false">
                {%- if card_product.featured_image -%}
                  {{-
                    card_product.featured_image
                    | image_url: width: 120
                    | image_tag:
                      class: 'brk-social__product-img',
                      loading: 'lazy',
                      width: 48,
                      height: 48,
                      draggable: 'false',
                      alt: card_product.featured_image.alt
                  -}}
                {%- endif -%}
                <span class="brk-social__product-info">
                  <span class="brk-social__product-title">{{ card_product.title }}</span>
                  <span class="brk-social__product-price">
                    {%- if card_product.compare_at_price > card_product.price -%}
                      <s>{{ card_product.compare_at_price | money }}</s>
                    {%- endif -%}
                    {{ card_product.price | money }}
                  </span>
                </span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <script>
    (function () {
      var root = document.getElementById('BrkSocial-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('.brk-social__track');
      var videos = root.querySelectorAll('.brk-social__video');

      // Posters só quando a seção chega perto da tela, para não disputar banda com a galeria
      function loadPosters() {
        videos.forEach(function (v) {
          if (v.dataset.poster) { v.poster = v.dataset.poster; v.removeAttribute('data-poster'); }
        });
      }
      if ('IntersectionObserver' in window) {
        var posterIo = new IntersectionObserver(function (entries) {
          if (!entries.some(function (e) { return e.isIntersecting; })) return;
          posterIo.disconnect();
          loadPosters();
        }, { rootMargin: '400px 0px' });
        posterIo.observe(root);
      } else {
        loadPosters();
      }

      // Toca só os vídeos visíveis na tela; pausa os que saem
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              var p = e.target.play();
              if (p && p.catch) p.catch(function () {});
            } else {
              e.target.pause();
            }
          });
        }, { threshold: 0.25 });
        videos.forEach(function (v) { io.observe(v); });
      } else {
        videos.forEach(function (v) { v.autoplay = true; v.play(); });
      }

      // Desktop: começa centralizado (cards cortados nas duas pontas)
      if (window.matchMedia('(min-width: 768px)').matches) {
        track.scrollLeft = (track.scrollWidth - track.clientWidth) / 2;
      }

      // Arrastar com o mouse
      var startX = 0, startScroll = 0, down = false, moved = false;
      track.addEventListener('pointerdown', function (e) {
        if (e.pointerType !== 'mouse') return;
        down = true; moved = false; startX = e.clientX; startScroll = track.scrollLeft;
      });
      window.addEventListener('pointermove', function (e) {
        if (!down) return;
        var dx = e.clientX - startX;
        if (!moved && Math.abs(dx) > 4) { moved = true; track.classList.add('is-dragging'); }
        if (moved) track.scrollLeft = startScroll - dx;
      });
      window.addEventListener('pointerup', function () {
        if (!down) return;
        down = false;
        if (moved) {
          var left = track.scrollLeft;
          track.classList.remove('is-dragging');
          track.scrollLeft = left;
        }
      });
      // Clique no card de produto não conta se foi um arraste
      track.addEventListener('click', function (e) {
        if (moved) { e.preventDefault(); moved = false; }
      }, true);
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="container">
    <p class="brk-social__editor-hint">
      Prova social oculta neste produto: adicione um grupo de vídeos ligado, com SKUs iniciais deste produto e pelo menos um vídeo.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .brk-social {
    --brk-social-blue: #135ed1;
    --brk-social-navy: #0f2e52;
    --brk-social-gap: 12px;
    overflow-x: clip;
    /* Pula a renderização enquanto está fora da tela; "auto" lembra a altura real depois da 1ª vez */
    content-visibility: auto;
    contain-intrinsic-size: auto 480px;
  }
  .brk-social .brk-social__heading {
    margin: 0 16px 20px;
    text-align: center;
    font-weight: 400;
    line-height: 1.1;
    text-transform: none;
    letter-spacing: 0;
  }
  .brk-social__eyebrow {
    display: block;
    font-size: 19px;
    color: var(--brk-social-navy);
  }
  .brk-social__title {
    display: block;
    font-size: 30px;
    font-weight: 700;
    color: var(--brk-social-blue);
  }
  .brk-social__track {
    display: flex;
    gap: var(--brk-social-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 16px;
    padding: 0 16px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .brk-social__track::-webkit-scrollbar {
    display: none;
  }
  .brk-social__track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }
  .brk-social__card {
    position: relative;
    flex: 0 0 78%;
    aspect-ratio: 5 / 6;
    border-radius: 16px;
    overflow: hidden;
    background: #f3f4f5;
    scroll-snap-align: start;
  }
  .brk-social__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .brk-social__influencer {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .brk-social__verified {
    width: 16px;
    height: 16px;
    flex: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
  }
  .brk-social__product {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--brk-social-navy);
    text-decoration: none;
  }
  .brk-social__product-img {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 8px;
    object-fit: cover;
    background: #fff;
  }
  .brk-social__product-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .brk-social__product-title {
    font-size: 13px;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .brk-social__product-price {
    font-size: 14px;
    font-weight: 700;
    color: var(--brk-social-blue);
  }
  .brk-social__product-price s {
    margin-right: 4px;
    font-weight: 400;
    color: #707070;
  }
  .brk-social__editor-hint {
    margin: 12px 0;
    padding: 12px;
    border: 1px dashed #c4c4c4;
    font-size: 13px;
    color: #707070;
  }
  @media (min-width: 768px) {
    .brk-social {
      --brk-social-gap: 18px;
      contain-intrinsic-size: auto 500px;
    }
    .brk-social .brk-social__heading {
      margin-bottom: 24px;
    }
    .brk-social__eyebrow {
      font-size: 22px;
    }
    .brk-social__title {
      font-size: 34px;
    }
    .brk-social__track {
      padding: 0;
      scroll-padding: 0;
    }
    .brk-social__card {
      flex-basis: clamp(200px, 21vw, 320px);
      scroll-snap-align: center;
      cursor: grab;
    }
    /* Poucos vídeos que cabem na tela: centraliza sem rolagem */
    .brk-social__track::before,
    .brk-social__track::after {
      content: '';
      flex: 1 0 0;
      margin-left: calc(var(--brk-social-gap) * -1);
    }
    .brk-social__track::after {
      margin-left: 0;
      margin-right: calc(var(--brk-social-gap) * -1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Prova social",
  "tag": "section",
  "class": "brk-social-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Adicione um grupo de vídeos por linha de produto. Aparece o primeiro grupo ligado em que algum SKU de variante começa com um dos prefixos."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Título (linha 1)",
      "default": "Feito para quem vive a pesca"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título (linha 2, destaque)",
      "default": "de verdade"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço acima",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço abaixo",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign column_gap = section_st.column_gap
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign heading = section_st.heading
  assign description = section_st.description
  assign show_arrow = section_st.show_arrow
  assign carousel_pagination = section_st.carousel_pagination
  assign collection_information_position = section_st.collection_information_position
  assign design = section_st.design
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  assign reveal = section_st.reveal
  assign items_per_row = section_st.items_per_row
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
  if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif
  assign rounded_image = section_st.rounded_image
  assign image_custom_width = section_st.image_custom_width
  assign scroll_animation = settings.scroll_animation
  assign animate_delay = 0
  assign layout = section_st.layout | default: 'circles'
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
  {% if column_gap < 15 %}--col-gap: {{ column_gap }}px;--col-gap-desktop: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{  column_gap }}px;{% endif %}
{%- endcapture -%}
{%- comment -%}
  Two size modes for the subcollection images:
  - "Image custom width" OFF -> media fills the column, so the column gap is the only spacing
    between items (0 = touching). Bigger circles = fewer columns (items per row).
    An optional lateral margin reduces the media width (kept centered) instead of overflowing.
  - "Image custom width" ON  -> media uses the fixed "Image width" (px) and stays centered, so
    you control the exact circle size (the "ANTES" look).
  1:1 ratio keeps rounded images perfectly circular in both modes.
{%- endcomment -%}
{%- style -%}
  {% unless image_custom_width %}
    #shopify-section-{{ section.id }} .collection-item__media {
      {% if section_st.media_horizontal_margin > 0 %}width: calc(100% - {{ section_st.media_horizontal_margin | times: 2 }}px);margin-left: auto;margin-right: auto;{% else %}width: 100%;{% endif %}
      max-width: 100%;
    }
  {% endunless %}
  {% if collection_information_position == 'below_image' and rounded_image %}
    #shopify-section-{{ section.id }} .collection-item__media--ratio {
      --aspect-ratio: 1 !important;
    }
  {% endif %}
{%- endstyle -%}
{% if section_st.image_border %}
  {%- style -%}
    #shopify-section-{{ section.id }} .collection-item__media {
      border: {{ section_st.image_border_width }}px solid {{ section_st.image_border_color }};
    }
  {%- endstyle -%}
{% endif %}
{% if image_custom_width %}
  {%- comment -%}
    Fixed-size mode: each slide is exactly the circle width on tablet/desktop (paired with the
    auto slidesPerView above). Applies pre- and post-init so there is no layout shift, and lets
    the column gap be the exact spacing between circles. Mobile keeps its column layout.
  {%- endcomment -%}
  {%- style -%}
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .swiper-slide {
        width: {{ section_st.image_width }}px;
        max-width: 100%;
      }
    }
  {%- endstyle -%}
{% endif %}
{% if collection.metafields.custom.subcollection.value %}
  {% assign sub_collection = collection.metafields.custom.subcollection.value %}
  {% if sub_collection != blank %}
    {% if layout == 'cards' %}
      {{ 'subcollection-rail.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'subcollection-rail.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    <div
      class="section remove_spacing{% unless layout == 'cards' %} mb-60{% endunless %}{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-list color-{{ color_scheme }} gradient{% if reveal %} overflow-hidden{% endif %}"
      style="{{ style | strip | strip_newlines }}{% if layout == 'cards' %}margin-bottom: {{ section_st.cards_margin_bottom }}px;{% endif %}"
    >
      <div class="{{ section_width }}">
        {%- if heading != blank or description != blank -%}
          <div
            class="section__header {% if layout == 'cards' %}subcol-rail__header{% else %}mb-33 mb-sm-20{% endif %} text-{{ section_st.header_alignment }}{% if section_st.section_width == 'full_width' %} px-20{% endif %}"
            {% if layout == 'cards' %}
              style="--sr-heading-size: {{ section_st.cards_heading_size }}px;"
            {% endif %}
          >
            {%- if section_st.heading != blank -%}
              <motion-element
                data-motion="{{ scroll_animation }}"
                data-motion-delay="{{ animate_delay }}"
                {% if scroll_animation == 'none' %}
                  hold
                {% endif %}
                class="block"
              >
                <h2
                  class="section__header-heading heading-letter-spacing {% if layout == 'cards' %}subcol-rail__heading{% else %}{{ header_size }}{% endif %} mt-0{% if section_st.description != blank %} mb-10{% else %} mb-0{% endif %}"
                >
                  {{ section.settings.heading }}
                </h2>
              </motion-element>
            {% endif %}
            {%- if section_st.description != blank -%}
              {%- assign animate_delay = animate_delay | plus: 50 -%}
              <motion-element
                data-motion="{{ scroll_animation }}"
                data-motion-delay="{{ animate_delay }}"
                {% if scroll_animation == 'none' %}
                  hold
                {% endif %}
                class="section__header-des block rich__text-m0{% if layout == 'cards' %} subcol-rail__subheading{% endif %}"
              >
                {{ section.settings.description }}
              </motion-element>
            {% endif %}
          </div>
        {% endif %}
        {% if layout == 'cards' %}
          {%- comment -%}
            Layout "cards horizontais": trilho com rolagem nativa (scroll-snap) + setas no desktop.
            Subtítulo de cada card: metafield custom.subtitle da subcoleção; sem ele, a descrição
            da coleção (sem HTML, 2 linhas) ou a contagem de produtos, conforme a configuração.
          {%- endcomment -%}
          <subcollection-rail
            class="subcol-rail{% if section_st.center_insufficient %} is-centered{% endif %}{% if section_st.cards_uppercase %} subcol-rail--uppercase{% endif %}"
            style="--sr-gap: {{ column_gap | at_least: 12 }}px; --sr-card-width: {{ section_st.cards_width }}px; --sr-card-width-mobile: {{ section_st.cards_width_mobile }}px; --sr-img-width: {{ section_st.cards_image_width }}px; --sr-img-ratio: {{ section_st.cards_image_ratio }}; --sr-img-fit: {{ section_st.cards_image_fit }}; --sr-radius: {{ section_st.cards_radius }}px; --sr-bg: {{ section_st.cards_background }}; --sr-border: {{ section_st.cards_border_color }}; --sr-accent: {{ section_st.cards_hover_color }}; --sr-title-size: {{ section_st.font_size }}px; --sr-subtitle-size: {{ section_st.cards_subtitle_size }}px;"
          >
            {% if show_arrow %}
              <button type="button" class="subcol-rail__arrow subcol-rail__arrow--prev" aria-label="Voltar" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
            {% endif %}
            <div class="subcol-rail__track">
              {% for card in sub_collection %}
                {%- liquid
                  if section_st.image_source == 'first_product'
                    assign card_media = card.products.first.featured_image
                  else
                    assign card_media = card.image | default: card.featured_image
                  endif

                  assign card_subtitle = ''
                  case section_st.cards_subtitle_source
                    when 'metafield'
                      assign card_subtitle = card.metafields.custom.subtitle.value
                      if card_subtitle == blank
                        assign card_subtitle = card.description | strip_html | strip | truncatewords: 12
                      endif
                    when 'product_count'
                      if card.products_count > 1
                        assign card_subtitle = 'general.collections.collection_count_multiple' | t: number: card.products_count
                      else
                        assign card_subtitle = 'general.collections.collection_count_single' | t: number: card.products_count
                      endif
                  endcase
                -%}
                <a href="{{ card.url }}" class="subcol-rail__card" draggable="false">
                  <div class="subcol-rail__media">
                    {%- if card_media -%}
                      {{
                        card_media
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          widths: '150, 300',
                          sizes: '(min-width: 768px) 150px, 100px',
                          alt: card.title
                      }}
                    {%- else -%}
                      {%- render 'placeholder-render' -%}
                    {%- endif -%}
                  </div>
                  <div class="subcol-rail__info">
                    <h3 class="subcol-rail__name">{{ card.title }}</h3>
                    {%- if card_subtitle != blank -%}
                      <p class="subcol-rail__desc">{{ card_subtitle }}</p>
                    {%- endif -%}
                  </div>
                </a>
              {% endfor %}
            </div>
            {% if show_arrow %}
              <button type="button" class="subcol-rail__arrow subcol-rail__arrow--next" aria-label="Avançar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            {% endif %}
          </subcollection-rail>
        {% else %}
        {% if scroll_animation %}
          <motion-items-effect data-motion="{{ scroll_animation }}">
        {% endif %}
        <slide-section
          class="swiper{% if reveal %} reveal_on_scroll{% endif %}{% if section_st.center_insufficient %} center-insufficient{% endif %}"
          data-section-id="{{ section.id }}"
          data-autoplay="{{ autoplay }}"
          data-effect="slide"
          data-loop="{{ infinite }}"
          data-speed="500"
          data-autoplay-speed="{{ autorotate_speed }}"
          data-spacing="{{ column_gap }}"
          data-mobile="{{ items_per_row_mobile }}"
          {%- comment -%}
            Fixed-size mode (image custom width ON): slides are auto-width (= the circle width set
            in CSS below) on tablet/desktop, so the column gap becomes the exact space between
            items instead of items being spread across equal columns. Fill mode keeps columns.
          {%- endcomment -%}
          {% if image_custom_width %}data-tablet="auto" data-desktop="auto"{% else %}data-desktop="{{ items_per_row }}"{% endif %}
          data-free-scroll="{{ data_free_scroll }}"
          data-center-insufficient="{{ section_st.center_insufficient }}"
          data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
        >
          {% if show_arrow %}
            {%- render 'swiper-navigation' -%}
          {% endif %}
          <div class="swiper-wrapper">
            {% for collection in sub_collection %}
              <div class="swiper-slide">
                <div
                  class="collection-item block motion-item {{ settings.hover_effect }}"
                >
                  {% render 'collection-item-sub',
                    card_collection: collection,
                    section: section,
                    collection_information_position: collection_information_position,
                    design: design,
                    image_source: section_st.image_source
                  %}
                </div>
              </div>
            {% endfor %}
          </div>
          {%- if carousel_pagination == 'show_dots'
            or carousel_pagination == 'show_dots_on_mobile'
            or carousel_pagination == 'show_progress_bar'
          -%}
            <div
              class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center{% if section_st.content_below_image %} absolute-md-impo{% endif %}"
              style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
            >
            </div>
          {% endif %}
        </slide-section>
        {% if scroll_animation %}
          </motion-items-effect>
        {% endif %}
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "t:sections.subcollection-list.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_width.container.label"
        },
        {
          "value": "fluid_container",
          "label": "t:sections.all.section_width.fluid_container.label"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.section_width.stretch_width.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_width.full_width.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Cards horizontais: carrossel compacto (imagem + nome + subtítulo lado a lado), ocupa bem menos altura.",
      "default": "circles",
      "options": [
        {
          "value": "circles",
          "label": "Imagens (padrão)"
        },
        {
          "value": "cards",
          "label": "Cards horizontais"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.section_header.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.section_header.heading.label",
      "default": "Collection list"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.section_header.description.label"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "t:sections.all.section_header.header_size.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:sections.all.section_header.header_size.small.label"
        },
        {
          "value": "medium",
          "label": "t:sections.all.section_header.header_size.medium.label"
        },
        {
          "value": "large",
          "label": "t:sections.all.section_header.header_size.large.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:sections.all.section_header.alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.section_header.alignment.left.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.section_header.alignment.center.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.section_header.alignment.right.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.collection.header"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.all.image.image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.all.image.image_ratio.adapt.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.image.image_ratio.square.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image.image_ratio.portrait.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image.image_ratio.landscape.label"
        },
        {
          "value": "custom",
          "label": "t:sections.all.image.image_ratio.custom.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "t:sections.all.image.image_ratio.custom_ratio.label"
    },
    {
      "type": "select",
      "id": "image_source",
      "label": "Fonte da imagem",
      "info": "Escolha qual imagem exibir em cada subcoleção.",
      "default": "banner",
      "options": [
        {
          "value": "banner",
          "label": "Usar imagem do banner (imagem da coleção)"
        },
        {
          "value": "first_product",
          "label": "Usar imagem do primeiro produto"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_horizontal_margin",
      "label": "Margem lateral da imagem",
      "info": "Espaço nas laterais de cada imagem, independente do espaçamento entre colunas (column gap) e da largura da imagem.",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Borda da imagem"
    },
    {
      "type": "checkbox",
      "id": "image_border",
      "label": "Ativar borda na imagem",
      "default": false
    },
    {
      "type": "range",
      "id": "image_border_width",
      "label": "Espessura da borda",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2,
      "visible_if": "{{ section.settings.image_border }}"
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Cor da borda",
      "default": "#085B47",
      "visible_if": "{{ section.settings.image_border }}"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "t:sections.all.items.items_per_row.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:sections.all.items.column_gap.label",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "center_insufficient",
      "label": "Centralizar itens quando não preencherem a linha",
      "info": "Ativado: centraliza quando há poucas subcoleções (gera margens nas laterais). Desativado: alinha à esquerda, sem margens laterais.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.collection_information.header"
    },
    {
      "type": "select",
      "id": "collection_information_position",
      "label": "t:sections.collection-list.settings.collection.collection_information_position.label",
      "options": [
        {
          "value": "overlay_image",
          "label": "t:sections.collection-list.settings.collection.collection_information_position.overlay_image"
        },
        {
          "value": "below_image",
          "label": "t:sections.collection-list.settings.collection.collection_information_position.below_image"
        }
      ],
      "default": "overlay_image"
    },
    {
      "type": "select",
      "id": "design",
      "label": "t:sections.all.design.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.design.default.label"
        },
        {
          "value": "morden",
          "label": "t:sections.all.design.morden.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.content_settings.content_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_settings.content_alignment.left.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_settings.content_alignment.center.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_settings.content_alignment.right.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:sections.collection-list.settings.collection.show_product_count"
    },
    {
      "type": "paragraph",
      "content": "t:sections.collection-list.settings.collection_information.collection_name"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:sections.all.content_settings.font_size.label",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "t:sections.all.content_settings.font_weight.label",
      "default": "heading_weight",
      "options": [
        {
          "value": "body_weight",
          "label": "t:sections.all.content_settings.font_weight.body_weight.label"
        },
        {
          "value": "subheading_weight",
          "label": "t:sections.all.content_settings.font_weight.subheading_weight.label"
        },
        {
          "value": "heading_weight",
          "label": "t:sections.all.content_settings.font_weight.heading_weight.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.collection.collection_information_position.content_below_image"
    },
    {
      "type": "range",
      "id": "information_spacing",
      "label": "t:sections.all.content_settings.spacing.spacing_top.label",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "rounded_image",
      "label": "t:sections.collection-list.settings.collection.rounded_image",
      "info": "t:sections.collection-list.settings.collection.image_custom_width.info"
    },
    {
      "type": "checkbox",
      "id": "image_custom_width",
      "label": "t:sections.collection-list.settings.collection.image_custom_width.label",
      "info": "t:sections.collection-list.settings.collection.image_custom_width.info"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "t:sections.collection-list.settings.collection.image_width",
      "min": 100,
      "max": 300,
      "step": 5,
      "default": 200,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Cards horizontais",
      "visible_if": "{{ section.settings.layout == 'cards' }}"
    },
    {
      "type": "paragraph",
      "content": "Usa também: Fonte da imagem, Espaçamento entre colunas, Centralizar itens, Tamanho da fonte (título do card) e Mostrar setas.",
      "visible_if": "{{ section.settings.layout == 'cards' }}"
    },
    {
      "type": "range",
      "id": "cards_heading_size",
      "label": "Tamanho do título da seção",
      "info": "No mobile o título fica um pouco menor automaticamente.",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.layout == 'cards' }}"
    },
    {
      "type": "select",
      "id": "cards_subtitle_source",
      "label": "Subtítulo do card",
      "info": "Metafield: usa custom.subtitle da subcoleção; se vazio, um trecho da descrição da coleção.",
      "default": "metafield",
      "options": [
        {
          "value": "metafield",
          "label": "Metafield / descrição da coleção"
        },
        {
          "value": "product_count",
          "label": "Quantidade de produtos"
        },
        {
          "value": "none",
          "label": "Sem subtítulo"
        }
      ],
      "visible_if": "{{ section.settings.layout == 'cards' }}"
    },
    {
      "type": "range",
      "id": "cards_subtitle_size",
      "label": "Tamanho do subtítulo",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.layout == 'cards' }}"
    },
    {
      "type": "checkbox",
      "id": "cards_uppercase",
